# --- Secrets - never commit these ---
config.json
.env
.env.*
!.env.example

# --- Generated at runtime - regenerated by fetch_data.py, holds live RSGx
# business data (financial values, vendor and staff names). Never commit. ---
data.json
PMO_Dashboard.html
PMO_Dashboard_artifact.html
.fetch.lock

# --- User-entered overlays - real per-deployment data, not source. Keep
# these out of git; back them up via the dashboard's own download buttons. ---
regions.json
delivery_dates.json

# --- Local tooling config, not part of the app ---
.claude/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Editor / OS noise ---
.DS_Store
Thumbs.db

# --- Scratch files from local testing ---
_tmp_check.js
_test_*.html
