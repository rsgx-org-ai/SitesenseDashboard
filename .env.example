# Copy this to .env for local testing of server.py, or set these as actual
# environment variables in Railway's dashboard (Variables tab). Never commit
# a real .env file - it is gitignored.

# --- Required: SiteSense credentials ---
# Same values as config.json's api_endpoint / auth_header_value. Set these on
# Railway instead of shipping config.json; locally, config.json still works
# as a fallback if these are unset.
SITESENSE_API_ENDPOINT=https://gateway.sitesensecloud.com/sitesenseapi/prod/query
SITESENSE_AUTH_HEADER=REPLACE_WITH_REAL_AUTH_HEADER_VALUE

# --- Required on first deploy: creates the first admin account ---
# Only used while no accounts exist. After the first admin signs in, all users
# are managed from the dashboard's Users tab and these are ignored. With no
# accounts and neither set, every sign-in is refused (the app never runs open).
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Optional: signs login cookies ---
# If unset, a random key is generated once and kept in DATA_DIR/.session_secret.
# Changing it signs everyone out.
SESSION_SECRET=

# --- Where generated files live ---
# Local use: leave unset: everything writes next to fetch_data.py, same as
# today. Railway: point this at a mounted Volume (e.g. /data) so data.json,
# the built dashboard, regions.json and delivery_dates.json all survive a
# redeploy instead of resetting to empty.
DATA_DIR=/data

# --- Daily auto-refresh time ---
# Hour of day (0-23) in UTC that server.py kicks off an automatic refresh,
# mirroring the Windows Task Scheduler job used locally. AWST is UTC+8, so
# 22 UTC = 6am AWST the next day. Optional; defaults to 22 if unset.
REFRESH_HOUR_UTC=22

# --- Set automatically by Railway - do not set this yourself ---
# PORT=8080
